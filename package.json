{
  "name": "@3zeros12/anchor",
  "version": "0.1.0",
  "description": "The zero-pollution, context-aware, self-evicting task protocol for AI coding agents",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "bin": {
    "anchor": "bin/anchor.js"
  },
  "pi": {
    "extensions": [
      "dist/extension.js"
    ]
  },
  "scripts": {
    "build": "tsup src/index.ts src/extension.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "pi-package",
    "ai-agent",
    "coding-agent",
    "task-management",
    "memory",
    "context-window",
    "zero-pollution",
    "pi-extension"
  ],
  "author": "Jason Song <jiaxinsong312@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52"
  }
}
