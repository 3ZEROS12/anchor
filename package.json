{
  "name": "pi-anchor",
  "version": "0.5.1",
  "description": "A digital sticky note docked below your Pi editor — stick notes in 0ms (pin: ...), track long tasks with micro progress bars [■■□□], jump back to the original session (↪), and auto-tear off on git commit.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "bin",
    "assets",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "bin": {
    "anchor": "bin/anchor.js"
  },
  "pi": {
    "extensions": [
      "dist/extension.js"
    ],
    "image": "https://raw.githubusercontent.com/3ZEROS12/anchor/main/assets/hero-en.svg"
  },
  "scripts": {
    "build": "tsup src/index.ts src/extension.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "prepack": "npm run build"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "anchor",
    "pi-anchor",
    "todo",
    "todos",
    "tasks",
    "task-management",
    "reminder",
    "reminders",
    "memory",
    "session",
    "session-memory",
    "handoff",
    "persistence",
    "checkpoint",
    "resume",
    "plan",
    "roadmap",
    "context-window",
    "zero-pollution",
    "ai-agent",
    "coding-agent"
  ],
  "author": "Jason Song <jiaxinsong312@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3ZEROS12/anchor.git"
  },
  "homepage": "https://github.com/3ZEROS12/anchor#readme",
  "bugs": {
    "url": "https://github.com/3ZEROS12/anchor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^26.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
